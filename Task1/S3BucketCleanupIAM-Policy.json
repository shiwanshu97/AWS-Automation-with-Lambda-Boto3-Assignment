{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3CleanupPermissions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::shiwanshu-cleanup-assignment"
    },
    {
      "Sid": "DeleteObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::shiwanshu-cleanup-assignment/*"
    }
  ]
}